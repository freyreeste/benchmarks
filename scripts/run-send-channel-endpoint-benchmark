set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
jar="${DIR}/../benchmarks-all/build/libs/benchmarks.jar"
agent_jar="${DIR}/../benchmarks-aeron/build/agent/aeron-agent.jar"

if [[ ! -f "${jar}" ]]; then
  "${DIR}/../gradlew" -p "${DIR}/.." :benchmarks-all:shadowJar
fi

if [[ ! -f "${agent_jar}" ]]; then
  "${DIR}/../gradlew" -p "${DIR}/.." :benchmarks-aeron:copyAeronAgent
fi

# JMH forked benchmark JVMs inherit the launching JVM's input arguments by default (that's
# also why the --add-opens/-D flags below reach the fork), so putting -javaagent here is
# enough to have it loaded in the benchmark fork without needing -jvmArgsAppend.
exec "${JAVA_HOME}/bin/java" \
  -Dagrona.disable.bounds.checks=true \
  -XX:+UseParallelGC \
  --add-opens java.base/jdk.internal.misc=ALL-UNNAMED \
  --add-opens java.base/java.util.zip=ALL-UNNAMED \
  "-javaagent:${agent_jar}" \
  -jar "${jar}" \
  SendChannelEndpointBenchmark \
  "$@"

# -f 1 -wi 1 -w 1s -i 1 -r 1s -tu us
# -jvmArgsAppend "-XX:TieredStopAtLevel=1"
# -jvmArgsAppend "-Xint"